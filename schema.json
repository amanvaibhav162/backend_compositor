{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the backend project and primary package identifier"
        },
        "nix": {
          "default": false,
          "description": "Generate hermetic Nix flake and shell for reproducible OS/runtime environments",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "nix"
      ],
      "additionalProperties": false,
      "description": "Project metadata and global settings"
    },
    "services": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique identifier for this service instance (e.g. \"express\", \"database\", \"auth\")"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Module type to load: \"express\", \"mongodb\", \"postgres\", \"jwt\", or \"oauth\""
          },
          "options": {
            "default": {},
            "description": "Module-specific configuration options and dependency overrides",
            "type": "object",
            "properties": {
              "dependencies": {
                "description": "Custom dependency semver overrides for this service",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "devDependencies": {
                "description": "Custom devDependency semver overrides for this service",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "type",
          "options"
        ],
        "additionalProperties": {},
        "description": "Configured backend service definition"
      },
      "description": "List of backend services to compose"
    }
  },
  "required": [
    "project",
    "services"
  ],
  "additionalProperties": false,
  "description": "BackForge declarative backend configuration"
}